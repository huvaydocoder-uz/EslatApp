# ============================================================================
# Eslat — muhit sozlamalari (NAMUNA)
#
#   1) Nusxa oling:   cp .env.example .env
#   2) Qiymatlarni Firebase Console -> Project settings -> Your apps dan to'ldiring.
#
# .env fayli .gitignore da — git'ga HECH QACHON tushmaydi.
# DIQQAT: bu yerga faqat ilova (client) sozlamalari yoziladi.
# Telegram bot TOKENI, SMS shlyuz kalitlari va boshqa server sirlari bu
# faylga YOZILMAYDI — ular faqat Cloud Functions Secret Manager'da turadi.
# ============================================================================

# --- Firebase: umumiy ---
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=

# --- Firebase: Android ilova ---
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=

# --- Firebase: iOS ilova ---
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_BUNDLE_ID=uz.eslat
FIREBASE_IOS_CLIENT_ID=

# --- Google Sign-In (2-qadam): Web client ID (OAuth) ---
GOOGLE_SERVER_CLIENT_ID=

# --- Telegram bot USERNAME (token emas!) ---
TELEGRAM_BOT_USERNAME=
